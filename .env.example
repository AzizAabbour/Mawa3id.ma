# ========================================================
# Mawa3id.ma Environment Configuration Template
# ========================================================

# Server
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_NAME=mawa3id
DATABASE_USERNAME=mawa3id
DATABASE_PASSWORD=mawa3id_secret_pwd
DATABASE_URL=jdbc:postgresql://localhost:5432/mawa3id
DATABASE_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=mawa3id
RABBITMQ_PASSWORD=mawa3id_rabbit_pwd

# JWT Security (Generate a secure 256-bit base64 key in production)
JWT_SECRET=dGVzdC1zZWNyZXQta2V5LW1hd2EzaWQtbW9yb2Njb2FwcC1wcm9kdWN0aW9uLXJlYWR5LTI1NmJpdHM=
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Notifications (WhatsApp Cloud API / SMS Gateway)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_API_KEY=YOUR_WHATSAPP_ACCESS_TOKEN

SMS_ENABLED=false
SMS_API_URL=https://api.sms-provider.ma/v1/send
SMS_API_KEY=YOUR_SMS_API_KEY

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@mawa3id.ma
